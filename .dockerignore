# NOTE: .dockerignore is NOT .gitignore.
# A bare pattern like `dist` matches ONLY the root-level path, not every depth.
# Use `**/` prefixes to match at any depth. Last matching pattern wins.

# ---------- Dependencies ----------
**/node_modules
.pnpm-store

# ---------- Build outputs ----------
**/dist
**/build
**/.turbo
**/*.tsbuildinfo
**/coverage

# ---------- Secrets (CRITICAL: all depths) ----------
**/.env
**/.env.*
!**/.env.example

# ---------- Databases & user data (CRITICAL) ----------
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db-journal
**/*.sqlite
**/*.sqlite3
storage/
apps/backend/storage/

# ---------- VCS, editors, tooling ----------
.git
.gitignore
.github
.husky
.vscode
.idea

# ---------- Logs & OS cruft ----------
**/*.log
**/.DS_Store

# ---------- Docker's own files ----------
Dockerfile*
docker-compose*.yml
.dockerignore
