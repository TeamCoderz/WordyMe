# NOTE: .dockerignore is NOT .gitignore.
# A bare pattern like `dist` matches ONLY the root-level path, not every depth.
# Use `**/` prefixes to match at any depth. Last matching pattern wins.

# ---------- Dependencies ----------
**/node_modules
.pnpm-store

# ---------- Build outputs ----------
**/dist
**/build
**/.turbo
**/*.tsbuildinfo
**/coverage

# ---------- Secrets (CRITICAL: all depths) ----------
**/.env
**/.env.*
!**/.env.example

# ---------- Databases & user data (CRITICAL) ----------
# WAL mode writes -wal and -shm alongside the database; the -wal file holds
# recent writes, so it leaks data just as the main file does.
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db-journal
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.sqlite-journal
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/*.sqlite3-journal
storage/
apps/backend/storage/

# ---------- VCS, editors, tooling ----------
.git
.gitignore
.github
.husky
.vscode
.idea

# ---------- Logs & OS cruft ----------
**/*.log
**/.DS_Store

# ---------- Docker's own files ----------
Dockerfile*
docker-compose*.yml
.dockerignore

# ---------- Non-runtime workspaces ----------
# The MCP server is a local development companion; nothing in the image depends
# on it, and excluding it keeps its edits out of the build context cache key.
apps/mcp
