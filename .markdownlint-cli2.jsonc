{
  // Markdown linting for the repository's documentation. Deliberately narrow:
  // Prettier already owns formatting, so this only covers the things Prettier
  // has no opinion about — code fences, links, heading structure.
  "config": {
    // Prettier decides where prose wraps. A hard column limit here would fight
    // it on every paragraph, and produced 223 of the 266 findings when this was
    // first run.
    "MD013": false,

    // The README badges are deliberate inline HTML; there is no Markdown syntax
    // for a centred row of shields.
    "MD033": false,
  },

  // CHANGELOG.md is generated by release-it from commit subjects. Linting
  // generated output means either fighting the generator or ignoring the rule,
  // so it is excluded rather than pretended to be hand-written. Excluding it
  // here is also why MD024 stays on above: every duplicate-heading finding in
  // this repository came from the changelog repeating "Bug Fixes" under each
  // version, so the rule can keep watching the documents people write.
  //
  // The .github templates follow GitHub's conventions rather than Markdown's:
  // the pull request template opens at "## Summary" so the heading does not
  // dominate every PR, and the issue templates use bold labels between form
  // fields. Both would have to change shape to satisfy the linter, which would
  // alter what contributors see for no benefit.
  "ignores": ["**/node_modules/**", "**/dist/**", "CHANGELOG.md", ".github/**"],
}
