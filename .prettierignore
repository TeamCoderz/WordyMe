# Prettier formats everything by default, including on every commit via the
# pre-commit hook. Anything listed here is either generated or not ours, so
# reformatting it produces churn that the next regeneration throws away.

# Generated by @tanstack/router-plugin on every build. Its own header asks to be
# excluded from linters and formatters; without this line the pre-commit hook
# rewrites ~500 lines of it on unrelated commits.
apps/web/src/routeTree.gen.ts

# Generated by drizzle-kit. The .sql files are applied migrations and must not
# change once committed; the meta/ snapshots are drizzle's own bookkeeping.
apps/backend/drizzle/

# Resolved by pnpm. Reformatting risks a diff the lockfile parser disagrees with.
pnpm-lock.yaml

# Build output and caches.
dist/
.turbo/
node_modules/

# Uploaded files and the local database. Gitignored, but Prettier does not read
# .gitignore, so `pnpm format` would otherwise walk whatever a developer has
# uploaded while testing.
apps/backend/storage/
