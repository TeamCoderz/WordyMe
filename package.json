{
  "name": "oss",
  "private": true,
  "version": "1.3.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:fix": "node scripts/spdx-license-cli.mjs add",
    "license:check": "node scripts/spdx-license-cli.mjs check",
    "check-types": "turbo run check-types",
    "start": "turbo start",
    "prepare": "lefthook install || echo 'lefthook: hooks not installed. Expected during Docker builds, which have no Git; otherwise run: pnpm exec lefthook install'"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "lefthook": "^2.1.4",
    "license-check-and-add": "^4.0.5",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "turbo": "^2.9.3",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3.1.5>brace-expansion": "1.1.16",
      "defu": "^6.1.7",
      "dompurify": "^3.4.13",
      "engine.io": "^6.6.7",
      "esbuild": "^0.25.0",
      "flatted": "^3.4.4",
      "handlebars": "^4.7.9",
      "kysely": "^0.28.17",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "mermaid": "^10.9.4",
      "nanoid": "^5.1.16",
      "path-to-regexp": "^8.4.2",
      "picomatch": "^4.0.5",
      "qs": "^6.15.2",
      "serialize-javascript": "^7.0.7",
      "socket.io-parser": "^4.2.7",
      "tar": "^7.5.19",
      "basic-ftp": "^5.2.1",
      "undici": "^6.24.0",
      "vite": "^8.2.0",
      "ws": "^8.21.1"
    }
  }
}
